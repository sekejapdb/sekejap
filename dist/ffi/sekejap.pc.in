prefix=@PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

Name: sekejap
Description: sekejap -- the compact typed embedded database (SQL, graph, spatial, vector, text) -- C ABI
URL: https://sekejap.life
Version: @VERSION@
Libs: -L${libdir} -lsekejap -Wl,-rpath,${libdir}
Cflags: -I${includedir}
