@@ -793 +793,17 @@
-impl Drop for PinnedWrite<'_> { fn drop(&mut self) { self.pool.unpin(self.frame, true) } }
+impl Drop for PinnedWrite<'_> { fn drop(&mut self) {
+    if !std::thread::panicking() {
+        let b=self.bytes();
+        let p=crate::page::PageRef::open_resident(b,self.page_no).unwrap();
+        if matches!(p.kind(),crate::page::PageKind::Leaf|crate::page::PageKind::Interior) {
+            let mut previous=None;
+            for i in 0..p.nentries() {
+                let key=match crate::verify::decode_record(p.slot(i),self.page_no,p.kind()).unwrap() {
+                    crate::verify::DecodedRecord::Leaf {key,..}|crate::verify::DecodedRecord::Interior {key,..}=>key,
+                };
+                assert!(previous.is_none_or(|old: &[u8]|old<key),"FIRST BAD WRITE GUARD page {} slot {} previous {:?} key {:?}",self.page_no,i,previous,key);
+                previous=Some(key);
+            }
+        }
+    }
+    self.pool.unpin(self.frame, true)
+} }
