{
  "name": "sekejap",
  "version": "0.17.0",
  "description": "Embedded graph-first multi-model database — Node.js & React Native binding",
  "license": "MIT OR Apache-2.0",
  "repository": "github:sekejapdb/sekejap",
  "homepage": "https://sekejap.life",
  "keywords": [
    "database",
    "graph",
    "vector",
    "spatial",
    "embedded",
    "multi-model",
    "typescript",
    "react-native"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./orm": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./orm/react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "dist/",
    "README.md"
  ],
  "napi": {
    "name": "sekejap"
  },
  "engines": {
    "node": ">= 16"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:orm": "tsc -p orm/tsconfig.build.json",
    "test:orm": "tsx orm/orm.test.ts"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
