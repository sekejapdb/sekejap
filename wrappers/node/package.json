{
  "name": "sekejap",
  "version": "0.13.0",
  "description": "Embedded graph-first multi-model database — Node.js binding",
  "license": "MIT OR Apache-2.0",
  "repository": "github:sekejapdb/sekejap",
  "homepage": "https://sekejap.zebflow.com",
  "keywords": ["database", "graph", "vector", "spatial", "embedded", "multi-model"],
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "sekejap",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "engines": { "node": ">= 16" },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}
